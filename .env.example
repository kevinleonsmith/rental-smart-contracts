# Copy to .env and fill in. .env is gitignored — never commit real values.
# Use a THROWAWAY dev wallet funded only with Sepolia test ETH. Never a wallet
# that holds real funds.

# JSON-RPC endpoint for Sepolia (e.g. from Alchemy, Infura, or a public RPC).
SEPOLIA_RPC_URL=

# Private key of the deploying wallet, WITHOUT the 0x prefix is fine either way.
PRIVATE_KEY=

# Optional: Etherscan API key to verify (publish) the source on the explorer.
ETHERSCAN_API_KEY=

# Optional: address that receives the platform fee. Defaults to the deployer.
PLATFORM_TREASURY=
